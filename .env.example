# Copie para .env (opcional). Nenhuma chave e necessaria: a solucao nao usa servico externo.
# Caminho do CSV de guias usado como lote base (padrao: vitalis/dados/guias.csv)
GUIAS_CSV=
# Caminho do JSON de regras (padrao: vitalis/dados/regras_convenio.json)
REGRAS_JSON=
# Data de referencia fixa para a verificacao de guias novas (AAAA-MM-DD). Vazio = hoje.
DATA_REFERENCIA=
